# =============================================================================
# FastAPI CNN Image Classifier - Environment Configuration
# =============================================================================

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
APP_NAME="CNN Image Classifier API"
APP_VERSION="2.1.0"
APP_DESCRIPTION="CNN Image Classifier API with MongoDB Atlas Storage"
APP_HOST="0.0.0.0"
APP_PORT=8000
APP_DEBUG=False
APP_RELOAD=True

# Environment (development, staging, production)
ENVIRONMENT="development"

# =============================================================================
# MONGODB ATLAS CONFIGURATION
# =============================================================================
# MongoDB Atlas Connection Details
MONGODB_USERNAME="sanjeevnidhir05"
MONGODB_PASSWORD="@123sanjeevni"
MONGODB_CLUSTER="cluster0.csdc7wq.mongodb.net"
MONGODB_DATABASE="image_classify"

# Full MongoDB Connection String
MONGODB_CONNECTION_STRING="mongodb+srv://sanjeevnidhir05:@123sanjeevni@cluster0.csdc7wq.mongodb.net/"

# MongoDB Connection Settings
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=5
MONGODB_SERVER_SELECTION_TIMEOUT=30000
MONGODB_CONNECT_TIMEOUT=20000
MONGODB_SOCKET_TIMEOUT=20000

# =============================================================================
# DATABASE COLLECTIONS
# =============================================================================
# Main collections
COLLECTION_PREDICTIONS="predictions"
COLLECTION_UPLOADED_IMAGES="uploaded_images"
COLLECTION_DATASET_CATS="cats"
COLLECTION_DATASET_DOGS="dogs"

# GridFS Buckets
GRIDFS_UPLOADS_BUCKET="images"
GRIDFS_DATASET_BUCKET="dataset_images"

# =============================================================================
# CNN MODEL CONFIGURATION
# =============================================================================
# Model file path
MODEL_PATH="models/model.h5"

# Model classes (comma-separated)
MODEL_CLASSES="cat,dog"

# Model input dimensions
MODEL_INPUT_HEIGHT=150
MODEL_INPUT_WIDTH=150
MODEL_INPUT_CHANNELS=3

# Model prediction settings
MODEL_CONFIDENCE_THRESHOLD=0.5
MODEL_BATCH_SIZE=1

# =============================================================================
# API SECURITY & CORS
# =============================================================================
# CORS Origins (comma-separated)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,https://*.onrender.com,https://*.vercel.app,https://*.netlify.app"

# API Keys (if you want to add authentication later)
API_KEY_HEADER="X-API-Key"
# API_KEY="your-secret-api-key-here"

# JWT Settings (for future authentication)
# JWT_SECRET_KEY="your-jwt-secret-key-here"
# JWT_ALGORITHM="HS256"
# JWT_EXPIRATION_TIME=3600

# =============================================================================
# FILE UPLOAD SETTINGS
# =============================================================================
# Maximum file size in bytes (10MB)
MAX_FILE_SIZE=10485760

# Allowed file extensions
ALLOWED_EXTENSIONS="png,jpg,jpeg,webp"

# Upload directory for temporary files
UPLOAD_TEMP_DIR="temp_uploads"

# Maximum files per request
MAX_FILES_PER_REQUEST=5

# =============================================================================
# PERFORMANCE & CACHING
# =============================================================================
# Request rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# Cache settings
CACHE_ENABLED=True
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# Performance metrics retention
METRICS_RETENTION_SIZE=1000

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL="INFO"

# Log file path
LOG_FILE="logs/app.log"

# Log rotation settings
LOG_MAX_SIZE=10485760
LOG_BACKUP_COUNT=5

# Enable/disable specific loggers
LOG_DATABASE=True
LOG_MODEL=True
LOG_API_REQUESTS=True
LOG_PERFORMANCE=True

# =============================================================================
# SYSTEM MONITORING
# =============================================================================
# Enable system monitoring (requires psutil)
SYSTEM_MONITORING_ENABLED=True

# Monitoring intervals in seconds
CPU_MONITORING_INTERVAL=1
MEMORY_MONITORING_INTERVAL=5
DISK_MONITORING_INTERVAL=10

# Alert thresholds
CPU_ALERT_THRESHOLD=80
MEMORY_ALERT_THRESHOLD=85
DISK_ALERT_THRESHOLD=90

# =============================================================================
# IMAGE PROCESSING SETTINGS
# =============================================================================
# Image preprocessing
IMAGE_RESIZE_QUALITY=95
IMAGE_COMPRESSION_ENABLED=True
IMAGE_OPTIMIZATION_ENABLED=True

# Thumbnail generation
GENERATE_THUMBNAILS=True
THUMBNAIL_SIZES="64x64,128x128,256x256"

# Image validation
VALIDATE_IMAGE_CONTENT=True
MAX_IMAGE_DIMENSIONS=4096

# =============================================================================
# BACKUP & MAINTENANCE
# =============================================================================
# Automatic backup settings
AUTO_BACKUP_ENABLED=False
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30
BACKUP_LOCATION="backups/"

# Database maintenance
AUTO_CLEANUP_ENABLED=True
CLEANUP_INTERVAL_HOURS=6
CLEANUP_OLD_PREDICTIONS_DAYS=30
CLEANUP_TEMP_FILES_HOURS=2

# =============================================================================
# EMAIL NOTIFICATIONS (Optional)
# =============================================================================
# SMTP settings for notifications
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USERNAME="your-email@gmail.com"
# SMTP_PASSWORD="your-app-password"
# SMTP_USE_TLS=True
# 
# # Notification settings
# ADMIN_EMAIL="admin@yourcompany.com"
# NOTIFICATION_ENABLED=False
# ERROR_NOTIFICATIONS=True
# PERFORMANCE_NOTIFICATIONS=False

# =============================================================================
# CLOUD STORAGE (Optional - for additional backup)
# =============================================================================
# AWS S3 Settings
# AWS_ACCESS_KEY_ID="your-access-key"
# AWS_SECRET_ACCESS_KEY="your-secret-key"
# AWS_BUCKET_NAME="your-bucket-name"
# AWS_REGION="us-east-1"

# Google Cloud Storage
# GCS_PROJECT_ID="your-project-id"
# GCS_BUCKET_NAME="your-bucket-name"
# GCS_CREDENTIALS_FILE="path/to/credentials.json"

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================
# Development flags
ENABLE_SWAGGER_UI=True
ENABLE_REDOC=True
ENABLE_DEBUG_ENDPOINTS=True

# Testing settings
TEST_DATABASE="image_classify_test"
TEST_MODEL_PATH="models/test_model.h5"
MOCK_PREDICTIONS=False

# =============================================================================
# PRODUCTION SETTINGS
# =============================================================================
# Production security
HIDE_INTERNAL_ERRORS=False
ENABLE_HTTPS_REDIRECT=False
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True

# Production performance
ENABLE_GZIP=True
STATIC_FILE_CACHING=True
API_RESPONSE_CACHING=False

# Health check settings
HEALTH_CHECK_TIMEOUT=30
DEEP_HEALTH_CHECK_ENABLED=True

# =============================================================================
# EXTERNAL SERVICES (Optional)
# =============================================================================
# Redis (for caching and sessions)
# REDIS_HOST="localhost"
# REDIS_PORT=6379
# REDIS_PASSWORD=""
# REDIS_DB=0

# Elasticsearch (for search functionality)
# ELASTICSEARCH_HOST="localhost"
# ELASTICSEARCH_PORT=9200
# ELASTICSEARCH_INDEX="image_classifications"

# =============================================================================
# CUSTOM FEATURES
# =============================================================================
# Custom model features
ENABLE_CONFIDENCE_CALIBRATION=False
ENABLE_BATCH_PROCESSING=True
ENABLE_MODEL_VERSIONING=False

# Analytics and reporting
ENABLE_ANALYTICS=True
ANALYTICS_RETENTION_DAYS=90
GENERATE_REPORTS=True

# Experimental features
ENABLE_EXPERIMENTAL_FEATURES=False
ENABLE_A_B_TESTING=False